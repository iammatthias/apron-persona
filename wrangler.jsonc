{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apron-persona",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "Bot" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bot"] }],
  "kv_namespaces": [{ "binding": "PERSONA", "id": "3767b51100654edab9666b9d9f416a08" }],
  "triggers": { "crons": [] },
  "vars": {
    "APRON_URL": "wss://server.apron.chat/",
    "ROOMS": "general",
    "BOT_NAME": "Apron Persona",
    "DECISION_MODEL": "inception/mercury-decide:free",
    "CHAT_MODEL": "openrouter/free",
    "DAILY_CALLS": "40",
    "HALF_LIFE_DAYS": "30"
  }
}
